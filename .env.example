# Copy to .env.local (local dev) and set the same variables in Vercel.
# Never commit .env.local.

# Supabase → Project Settings → API
# The anon/publishable key is designed to be public: Row Level Security
# protects the data. Without these two, the public site uses the sample
# data from data/*.ts and the admin panel shows setup instructions.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# The app itself needs NO service-role key. Keep it out of this project;
# use it only in the Supabase dashboard / CLI if ever needed.
